# Discord bot token (Discord Developer Portal -> Bot -> Token). Required.
BOT_TOKEN=

# Channel ID the scanner watches for file attachments. Optional -- defaults
# to the value hardcoded in config/channels.js (KEYLOGGER_SCAN_CHANNEL_ID)
# if not set here.
SCAN_CHANNEL_ID=

# OpenAI API key for the owner-only AI Core (stored in Replit Secrets).
# Never commit a real key here.
OPENAI_API_KEY=
